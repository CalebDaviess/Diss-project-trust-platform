# Base URL of the accountability-service (Quarkus) backend.
# Defaults to http://localhost:8081 if unset.
VITE_API_BASE_URL=http://localhost:8081
# Demo login prefilled into the sign-in form (dev only). The player signs in via
# POST /auth to obtain a JWT, which is then sent as `Authorization: Bearer <token>`.
# These match the dev/test demo user seeded by the backend (DemoUserSeeder).
VITE_DEMO_USERNAME=player@example.com
VITE_DEMO_PASSWORD=demo-password
