# ─────────────────────────────────────────────────────────────
# Python (detection-engine/)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
# Large / generated ML artefacts (keep the folders via .gitkeep)
detection-engine/models/*
!detection-engine/models/.gitkeep
detection-engine/data/*
!detection-engine/data/.gitkeep
!detection-engine/data/sample/
detection-engine/data/sample/*
!detection-engine/data/sample/.gitkeep

# ─────────────────────────────────────────────────────────────
# Java / Maven / Quarkus (accountability-service/)
# ─────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
# Quarkus
.quarkus/
# JWT signing keys — generated on demand (DEV ONLY), never committed.
# Prod injects real keys via smallrye.jwt.sign.key.location / mp.jwt.verify.publickey.location.
accountability-service/src/main/resources/jwt/*.pem

# ─────────────────────────────────────────────────────────────
# Node (player-portal/)
# ─────────────────────────────────────────────────────────────
node_modules/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─────────────────────────────────────────────────────────────
# Environment / secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─────────────────────────────────────────────────────────────
# Obsidian (dissertation-vault/)
# Keep vault config tracked; ignore only per-machine UI state & cache.
# ─────────────────────────────────────────────────────────────
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.trash/

# ─────────────────────────────────────────────────────────────
# IDE / OS
# ─────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db


# ─────────────────────────────────────────────────────────────
# Not part of this project / not for version control
# ─────────────────────────────────────────────────────────────
# Separate nested git repo (coursework assistant template) living in the tree
coursework-template/
# Survey instrument exemplar PDFs — kept out of the repo
dissertation-vault/10-SurveyForms/*.pdf
# Endpoint-DLP sidecar files
*sec.endpointdlp
